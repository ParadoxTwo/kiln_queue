<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Kiln Queue" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <header>
      <strong>Kiln Queue</strong>
      <nav>
        <%= link_to "Firings", firings_path %>
        <%= link_to "Pieces", pieces_path %>
        <%= link_to "Members", members_path %>
      </nav>
    </header>
    <main>
      <% if notice %><p class="flash notice"><%= notice %></p><% end %>
      <% if alert %><p class="flash alert"><%= alert %></p><% end %>
      <%= yield %>
    </main>
  </body>
</html>
